PORT=4000

# Virgülle ayırın. Yerel + canlı frontend subdomain'leri
CORS_ORIGIN=http://localhost:3000,https://fiyatgor.dervisplastik.com,https://admin.dervisplastik.com,https://personel.dervisplastik.com,https://satis.dervisplastik.com,https://giris.dervisplastik.com

ADMIN_SECRET=degistirin-guclu-bir-sifre

# Yerel geliştirme: DATABASE_URL boş bırakın → SQLite (backend/data/products.db)
# Railway PostgreSQL: Variables sekmesinden DATABASE_URL kopyalayın
# Örnek: postgresql://postgres:PASSWORD@host:PORT/railway
DATABASE_URL=

# Railway ayrı ayrı değişken verirse (opsiyonel — DATABASE_URL yeterli):
# PGHOST=
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=railway

# ——— Tigris / S3 (ürün resimleri, presigned URL) ———
# Railway → backend Variables'a ekleyin. Secret'ları repoya koymayın.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=foldable-basketcase-tru32x
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Genel erişim URL tabanı (path-style). Boşsa endpoint/bucket kullanılır.
S3_PUBLIC_BASE_URL=https://t3.storageapi.dev/foldable-basketcase-tru32x
# Bucket private ise (varsayılan) resimler süreli presigned GET URL ile servis edilir.
# Bucket'ı herkese açık okunur yaptıysanız true yapın; sabit URL'ler kullanılır (daha iyi cache).
S3_PUBLIC_READ=false

# ——— Mesai / yoklama (giris.dervisplastik.com) ———
# Dükkanın koordinatları — Google Maps'te dükkana sağ tıklayıp koordinatı kopyalayın.
SHOP_LAT=37.1591
SHOP_LNG=38.7969
# Bu yarıçapın (metre) dışından mesai başlatılamaz. GPS sapması için 100-200 m önerilir.
SHOP_RADIUS_M=150
# Yoklama kesimi: bu saate kadar giriş = Tam Gün, sonrası = Yarım Gün
ATTENDANCE_HALF_DAY_AFTER=11:00
# Mesai bitişi = akşam ezanı. Diyanet'in resmi Şanlıurfa tablosu kullanılır
# (backend/src/data/prayer-times-<yıl>.json). Aşağıdaki ofset yalnızca tablosu
# olmayan yıllarda devreye giren gün batımı tahmininde kullanılır.
MAGHRIB_OFFSET_MIN=7
