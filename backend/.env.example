PORT=4000

# Virgülle ayırın. Yerel + canlı frontend subdomain'leri
CORS_ORIGIN=http://localhost:3000,https://fiyatgor.dervisplastik.com,https://admin.dervisplastik.com,https://personel.dervisplastik.com

ADMIN_SECRET=degistirin-guclu-bir-sifre

# Yerel geliştirme: DATABASE_URL boş bırakın → SQLite (backend/data/products.db)
# Railway PostgreSQL: Variables sekmesinden DATABASE_URL kopyalayın
# Örnek: postgresql://postgres:PASSWORD@HOST:PORT/railway
DATABASE_URL=

# Railway ayrı ayrı değişken verirse (opsiyonel — DATABASE_URL yeterli):
# PGHOST=
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=railway
